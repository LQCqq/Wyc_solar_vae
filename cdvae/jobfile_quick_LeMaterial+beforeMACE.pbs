#!/bin/bash

#PBS -N LeMat_bench_beforeMACR

#PBS -l select=1:ncpus=8:mem=46gb:ngpus=1

#PBS -l walltime=12:00:00

#PBS -M z5561341@ad.unsw.edu.au

#PBS -m ae

#PBS -j oe

#PBS -o /srv/scratch/ml4matdis/Quanli_Project/EGS/HMTC/logs/train_test.log

source /srv/scratch/ml4matdis/Quanli_Project/EGS/HMTC/venvs/hmtc/bin/activate

cd /srv/scratch/ml4matdis/Quanli_Project/EGS/HMTC

python -u scripts/train.py \
  --data-dir data/mp_20_hmtc \
  --config conf/base.yaml \
  --output runs/debug/hmtc_mp20_debug.pt \
  --epochs 2 \
  --batch-size 8 \
  --learning-rate 0.0002 \
  --device cuda1/SMACT_structure/formal_smact_structure --config comprehensive_multi_mlip_hull --name my_benchmark